---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const herramientas = (await getCollection('herramientas')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Herramientas — ${SITE_TITLE}`} description="Herramientas de IA imprescindibles, explicadas sin tecnicismos." />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">Herramientas</h1>
			<p class="intro">IA aplicada al día a día. Sin tecnicismos, sin humo. Solo lo que merece la pena.</p>
			<ul>
				{herramientas.map((h) => (
					<li>
						<a href={`/herramientas/${h.id}/`} class="card">
							<div class="card-top">
								<span class="etiqueta">{h.data.etiqueta}</span>
								<span class:list={['badge', h.data.gratis ? 'gratis' : 'pago']}>
									{h.data.gratis ? 'Gratis' : 'De pago'}
								</span>
							</div>
							<h2>{h.data.title}</h2>
							<p>{h.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-title {
		font-size: 1.75rem;
		margin-bottom: 0.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid #D8D6CE;
	}
	.intro {
		color: #5F5E5A;
		font-size: 1rem;
		margin: 1rem 0 2rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.25rem;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid #B8D4BC;
		border-radius: 10px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.card:hover {
		border-color: #6B8F71;
		box-shadow: 0 2px 12px rgba(107, 143, 113, 0.12);
	}
	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.etiqueta {
		font-size: 0.75rem;
		color: #888780;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.badge {
		font-size: 0.7rem;
		font-weight: 500;
		padding: 2px 8px;
		border-radius: 20px;
	}
	.badge.gratis {
		background: #E8F4EA;
		color: #4a6b50;
	}
	.badge.pago {
		background: #F4EDE8;
		color: #8B5E3C;
	}
	.card h2 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.2rem;
		margin: 0;
		line-height: 1.3;
	}
	.card p {
		font-size: 0.875rem;
		color: #5F5E5A;
		line-height: 1.6;
		margin: 0;
	}
</style>
