---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ShareButtons from '../../components/ShareButtons.astro';

export async function getStaticPaths() {
	const herramientas = await getCollection('herramientas');
	return herramientas.map((h) => ({
		params: { slug: h.id },
		props: h,
	}));
}

type Props = CollectionEntry<'herramientas'>;

const herramienta = Astro.props;
const { title, description, pubDate, url, gratis, etiqueta } = herramienta.data;
const { Content } = await render(herramienta);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title} description={description} type="article" />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<div class="meta">
						<span class="etiqueta">{etiqueta}</span>
						<span class:list={['badge', gratis ? 'gratis' : 'pago']}>
							{gratis ? 'Gratis' : 'De pago'}
						</span>
					</div>
					<h1>{title}</h1>
					<p class="description">{description}</p>
					<ShareButtons url={Astro.url.href} title={title} />
					<a href={url} target="_blank" rel="noopener noreferrer" class="btn-web">
						Visitar {title} →
					</a>
					<hr />
				</header>
				<div class="prose">
					<Content />
				</div>
				<ShareButtons url={Astro.url.href} title={title} />
				<footer class="post-footer">
					<a href="/herramientas">← Volver a herramientas</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		padding: 2.5rem 0 0;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}
	.etiqueta {
		font-size: 0.75rem;
		color: #888780;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.badge {
		font-size: 0.7rem;
		font-weight: 500;
		padding: 2px 8px;
		border-radius: 20px;
	}
	.badge.gratis {
		background: #E8F4EA;
		color: #4a6b50;
	}
	.badge.pago {
		background: #F4EDE8;
		color: #8B5E3C;
	}
	h1 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 2.25rem;
		line-height: 1.2;
		margin: 0 0 0.75rem;
		max-width: 680px;
	}
	.description {
		font-size: 1.05rem;
		color: #5F5E5A;
		margin: 0 0 1.25rem;
		max-width: 600px;
	}
	.btn-web {
		display: inline-block;
		background: #6B8F71;
		color: #fff;
		padding: 0.6rem 1.25rem;
		border-radius: 6px;
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		margin-bottom: 1.5rem;
		transition: background 0.15s;
	}
	.btn-web:hover {
		background: #4a6b50;
		color: #fff;
	}
	hr {
		border: none;
		border-top: 1px solid #D8D6CE;
		margin: 0 0 2.5rem;
	}
	.prose {
		max-width: 660px;
		font-size: 1.05rem;
		line-height: 1.8;
		color: #2C2C2A;
	}
	.prose p { margin-bottom: 1.5rem; }
	.prose strong { font-weight: 500; color: #1a1a18; }
	.prose em { font-style: italic; color: #5F5E5A; }
	.prose blockquote {
		border-left: 3px solid #6B8F71;
		padding: 0.25rem 0 0.25rem 1.25rem;
		margin: 1.5rem 0;
		color: #5F5E5A;
		font-style: italic;
	}
	.post-footer {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #D8D6CE;
	}
	.post-footer a {
		font-size: 0.9rem;
		color: #6B8F71;
		font-weight: 500;
		text-decoration: none;
	}
	.post-footer a:hover { color: #4a6b50; }
	@media (max-width: 720px) {
		h1 { font-size: 1.75rem; }
	}
</style>
