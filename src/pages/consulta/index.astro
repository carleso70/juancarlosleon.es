---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('consulta', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Consulta" description="Formación, contexto y conocimiento para entender la IA (y de paso, la vida) sin tecnicismos. Gratis, como debe ser." />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a16,16,0,1,1,16,16A16,16,0,0,1,112,84Z"/></svg> Consulta</h1>
				<p>Formación, contexto y conocimiento para entender la IA (y de paso, la vida) sin tecnicismos. Gratis, como debe ser.</p>
			</section>
			<section class="listing">
				{posts.map(post => (
					<a href={`/consulta/${post.id}/`} class="card">
						<h2>{post.data.title}</h2>
						<p>{post.data.description}</p>
					</a>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		padding: 2.5rem 0 2rem;
		border-bottom: 1px solid #D8D6CE;
		margin-bottom: 2.5rem;
	}
	.page-header h1 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 2.25rem;
		margin-bottom: 0.75rem;
	}
	.page-header p {
		font-size: 1.05rem;
		color: #5F5E5A;
		max-width: 560px;
	}
	.listing {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding-bottom: 3rem;
	}
	.card {
		display: block;
		padding: 1.5rem;
		border: 1px solid #D8D6CE;
		border-radius: 10px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.card:hover {
		border-color: #6B8F71;
		box-shadow: 0 2px 12px rgba(107, 143, 113, 0.1);
	}
	time {
		font-size: 0.75rem;
		color: #888780;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		display: block;
		margin-bottom: 0.5rem;
	}
	h2 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.2rem;
		line-height: 1.35;
		margin: 0 0 0.5rem;
		color: #2C2C2A;
	}
	p {
		font-size: 0.9rem;
		color: #5F5E5A;
		line-height: 1.6;
		margin: 0;
	}
</style>
