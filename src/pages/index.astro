---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>La IA no va a cambiar el mundo.<br/>Ya lo está haciendo.</h1>
				<p class="subtitle">Y la pregunta no es si te afecta, sino cómo navegarlo sin perder la cabeza — ni la tuya ni la mía.</p>
				<a href="/blog" class="btn">Leer el blog</a>
			</section>

			<section class="recent-posts">
				<h2>Últimas entradas</h2>
				<ul>
					{posts.map(post => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-title">{post.data.title}</span>
								<span class="post-date">{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
							</a>
						</li>
					))}
				</ul>
				<a href="/blog" class="all-posts">Ver todas las entradas →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2rem 0 3rem;
		border-bottom: 1px solid #D8D6CE;
		margin-bottom: 3rem;
	}
	.hero h1 {
		font-size: 2.4rem;
		line-height: 1.25;
		margin-bottom: 1.25rem;
		max-width: 700px;
	}
	.subtitle {
		font-size: 1.1rem;
		color: #5F5E5A;
		max-width: 520px;
		margin-bottom: 2rem;
		line-height: 1.7;
	}
	.btn {
		display: inline-block;
		background: #6B8F71;
		color: #fff;
		padding: 0.65rem 1.5rem;
		border-radius: 6px;
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
		transition: background 0.15s;
	}
	.btn:hover {
		background: #4a6b50;
		color: #fff;
	}
	.recent-posts h2 {
		font-size: 1.25rem;
		margin-bottom: 1.5rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem;
	}
	li {
		border-bottom: 1px solid #D8D6CE;
	}
	li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem 0;
		color: #2C2C2A;
		text-decoration: none;
		transition: color 0.15s;
	}
	li a:hover {
		color: #6B8F71;
	}
	.post-title {
		font-size: 1rem;
	}
	.post-date {
		font-size: 0.8rem;
		color: #888780;
		white-space: nowrap;
	}
	.all-posts {
		font-size: 0.9rem;
		color: #6B8F71;
		font-weight: 500;
	}
	.all-posts:hover {
		color: #4a6b50;
	}
	@media (max-width: 720px) {
		.hero h1 { font-size: 2rem; }
		li a { flex-direction: column; gap: 0.25rem; }
		.post-date { align-self: flex-start; }
	}
</style>
