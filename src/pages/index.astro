---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const herramientas = (await getCollection('herramientas')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const contraindicaciones = (await getCollection('contraindicaciones')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>La IA no va a cambiar el mundo.<br/>Ya lo está haciendo.</h1>
				<p class="subtitle">Y la pregunta no es si te afecta, sino cómo navegarlo sin perder la cabeza — ni la tuya ni la mía.</p>
			</section>

			<section class="recent-posts">
				<div class="cards">
					{posts.map(post => (
						<a href={`/blog/${post.id}/`} class="card">
							<time>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
							<h3>{post.data.title}</h3>
							{post.data.description && (
								<p>{post.data.description}</p>
							)}
						</a>
					))}
				</div>
				<a href="/blog" class="btn">Ver más</a>
			</section>

			<section class="recent-tools">
				<div class="cards">
					{herramientas.map(h => (
						<a href={`/herramientas/${h.id}/`} class="card">
							<div class="card-top">
								<span class="etiqueta">{h.data.etiqueta}</span>
								<span class:list={['badge', h.data.gratis ? 'gratis' : 'pago']}>
									{h.data.gratis ? 'Gratis' : 'De pago'}
								</span>
							</div>
							<h3>{h.data.title}</h3>
							<p>{h.data.description}</p>
						</a>
					))}
				</div>
				<a href="/herramientas" class="btn">Ver Botiquín</a>
			</section>

			<section class="recent-contra">
				<div class="cards cards-contra">
					{contraindicaciones.map(post => (
						<a href={`/contraindicaciones/${post.id}/`} class="card card-contra">
							<time>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
							<span class="fuente-tag">{post.data.fuente}</span>
						</a>
					))}
				</div>
				<a href="/contraindicaciones" class="btn btn-contra">Ver contraindicaciones</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2rem 0 3rem;
		border-bottom: 1px solid #D8D6CE;
		margin-bottom: 3rem;
	}
	.hero h1 {
		font-size: 2.4rem;
		line-height: 1.25;
		margin-bottom: 1.25rem;
		max-width: 700px;
	}
	.subtitle {
		font-size: 1.1rem;
		color: #5F5E5A;
		max-width: 520px;
		margin-bottom: 2rem;
		line-height: 1.7;
	}
	.btn {
		display: inline-block;
		background: #6B8F71;
		color: #fff;
		padding: 0.65rem 1.5rem;
		border-radius: 6px;
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
		transition: background 0.15s;
	}
	.btn:hover {
		background: #4a6b50;
		color: #fff;
	}
	.recent-posts h2 {
		font-size: 1.25rem;
		margin-bottom: 1.5rem;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin-bottom: 1.75rem;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid #B8D4BC;
		border-radius: 10px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.card:hover {
		border-color: #6B8F71;
		box-shadow: 0 2px 12px rgba(107, 143, 113, 0.12);
	}
	.card time {
		font-size: 0.75rem;
		color: #888780;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.card h3 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.05rem;
		line-height: 1.35;
		margin: 0;
		color: #2C2C2A;
	}
	.card p {
		font-size: 0.875rem;
		color: #5F5E5A;
		line-height: 1.6;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.recent-tools {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #D8D6CE;
	}
	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.etiqueta {
		font-size: 0.75rem;
		color: #888780;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.badge {
		font-size: 0.7rem;
		font-weight: 500;
		padding: 2px 8px;
		border-radius: 20px;
	}
	.badge.gratis {
		background: #E8F4EA;
		color: #4a6b50;
	}
	.badge.pago {
		background: #F4EDE8;
		color: #8B5E3C;
	}
	.recent-contra {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #D8D6CE;
	}
	.cards-contra .card {
		border-color: #E8D4C8;
	}
	.card-contra:hover {
		border-color: #C17A5A !important;
		box-shadow: 0 2px 12px rgba(193, 122, 90, 0.1) !important;
	}
	.fuente-tag {
		font-size: 0.72rem;
		color: #C17A5A;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.btn-contra {
		background: #C17A5A;
	}
	.btn-contra:hover {
		background: #9e5c3a !important;
	}
	@media (max-width: 720px) {
		.hero h1 { font-size: 2rem; }
		.cards { grid-template-columns: 1fr; }
	}
</style>
