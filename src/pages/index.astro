---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>La IA no va a cambiar el mundo.<br/>Ya lo está haciendo.</h1>
				<p class="subtitle">Y la pregunta no es si te afecta, sino cómo navegarlo sin perder la cabeza — ni la tuya ni la mía.</p>
				<a href="/blog" class="btn">Leer el blog</a>
			</section>

			<section class="recent-posts">
				<div class="cards">
					{posts.map(post => (
						<a href={`/blog/${post.id}/`} class="card">
							<time>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
							<h3>{post.data.title}</h3>
							{post.data.description && (
								<p>{post.data.description}</p>
							)}
						</a>
					))}
				</div>
				<a href="/blog" class="all-posts">Ver todas las entradas →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2rem 0 3rem;
		border-bottom: 1px solid #D8D6CE;
		margin-bottom: 3rem;
	}
	.hero h1 {
		font-size: 2.4rem;
		line-height: 1.25;
		margin-bottom: 1.25rem;
		max-width: 700px;
	}
	.subtitle {
		font-size: 1.1rem;
		color: #5F5E5A;
		max-width: 520px;
		margin-bottom: 2rem;
		line-height: 1.7;
	}
	.btn {
		display: inline-block;
		background: #6B8F71;
		color: #fff;
		padding: 0.65rem 1.5rem;
		border-radius: 6px;
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
		transition: background 0.15s;
	}
	.btn:hover {
		background: #4a6b50;
		color: #fff;
	}
	.recent-posts h2 {
		font-size: 1.25rem;
		margin-bottom: 1.5rem;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin-bottom: 1.75rem;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid #D8D6CE;
		border-radius: 10px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.card:hover {
		border-color: #6B8F71;
		box-shadow: 0 2px 12px rgba(107, 143, 113, 0.12);
	}
	.card time {
		font-size: 0.75rem;
		color: #888780;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.card h3 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.05rem;
		line-height: 1.35;
		margin: 0;
		color: #2C2C2A;
	}
	.card p {
		font-size: 0.875rem;
		color: #5F5E5A;
		line-height: 1.6;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.all-posts {
		font-size: 0.9rem;
		color: #6B8F71;
		font-weight: 500;
		text-decoration: none;
	}
	.all-posts:hover {
		color: #4a6b50;
	}
	@media (max-width: 720px) {
		.hero h1 { font-size: 2rem; }
		.cards { grid-template-columns: 1fr; }
	}
</style>
