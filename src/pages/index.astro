---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const herramientas = (await getCollection('herramientas')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const contraindicaciones = (await getCollection('contraindicaciones')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const recetas = (await getCollection('recetas')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const hoy = new Date();
const esDeHoy = (fecha: Date) => {
	return fecha.getFullYear() === hoy.getFullYear() &&
		fecha.getMonth() === hoy.getMonth() &&
		fecha.getDate() === hoy.getDate();
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>La IA no va a cambiar el mundo.<br/>Ya lo está haciendo.</h1>
				<p class="subtitle">Y la pregunta no es si te afecta, sino cómo navegarlo sin perder la cabeza — ni la tuya ni la mía.</p>
			</section>

			<section class="recent-posts">
				<h2 class="section-title">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M228.24,59.76a52,52,0,0,0-73.53,0L43.76,170.71a52,52,0,0,0,73.53,73.53L228.24,133.29A52.06,52.06,0,0,0,228.24,59.76ZM101.65,228.59a36,36,0,0,1-50.9-50.94l50.52-50.52,50.93,50.93Zm115-115-48.82,48.82L117,111.5l48.82-48.82a36,36,0,0,1,50.9,50.94Z"/></svg>
					Píldoras
				</h2>
				<div class="cards">
					{posts.map(post => (
						<a href={`/blog/${post.id}/`} class:list={['card', { 'card--hoy': esDeHoy(post.data.pubDate) }]}>
							{esDeHoy(post.data.pubDate) && <span class="badge-hoy">Nuevo hoy</span>}
							<time>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
							<h3>{post.data.title}</h3>
							{post.data.description && (
								<p>{post.data.description}</p>
							)}
						</a>
					))}
				</div>
				<a href="/blog" class="btn">Ver más</a>
			</section>

			<section class="recent-tools">
				<h2 class="section-title">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M216,72H184V64a24,24,0,0,0-24-24H96A24,24,0,0,0,72,64v8H40A16,16,0,0,0,24,88V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V88A16,16,0,0,0,216,72ZM88,64a8,8,0,0,1,8-8h64a8,8,0,0,1,8,8v8H88ZM216,200H40V88H216V200Zm-40-72a8,8,0,0,1-8,8H136v32a8,8,0,0,1-16,0V136H88a8,8,0,0,1,0-16h32V88a8,8,0,0,1,16,0v32h32A8,8,0,0,1,176,128Z"/></svg>
					Botiquín
				</h2>
				<div class="cards">
					{herramientas.map(h => (
						<a href={`/herramientas/${h.id}/`} class:list={['card', { 'card--hoy': esDeHoy(h.data.pubDate) }]}>
							<div class="card-top">
								<span class="etiqueta">{h.data.etiqueta}</span>
								<span class:list={['badge', h.data.gratis ? 'gratis' : 'pago']}>
									{h.data.gratis ? 'Gratis' : 'De pago'}
								</span>
							</div>
							<h3>{h.data.title}</h3>
							<p>{h.data.description}</p>
						</a>
					))}
				</div>
				<a href="/herramientas" class="btn">Ver Botiquín</a>
			</section>

			<section class="recent-contra">
				<h2 class="section-title section-title-contra">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M236.8,188.09,149.35,36.22a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM120,104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm8,88a12,12,0,1,1,12-12A12,12,0,0,1,128,192Z"/></svg>
					Contraindicaciones
				</h2>
				<div class="cards cards-contra">
					{contraindicaciones.map(post => (
						<a href={`/contraindicaciones/${post.id}/`} class:list={['card', 'card-contra', { 'card--hoy': esDeHoy(post.data.pubDate) }]}>
							{esDeHoy(post.data.pubDate) && <span class="badge-hoy">Nuevo hoy</span>}
							<time>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
							<span class="fuente-tag">{post.data.fuente}</span>
						</a>
					))}
				</div>
				<a href="/contraindicaciones" class="btn btn-contra">Ver contraindicaciones</a>
			</section>

			<section class="recent-recetas">
				<h2 class="section-title section-title-recetas">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H136v24a8,8,0,0,1-16,0V144H96a8,8,0,0,1,0-16h24V104a8,8,0,0,1,16,0v24h24A8,8,0,0,1,168,136Z"/></svg>
					Recetas
				</h2>
				<div class="cards cards-recetas">
					{recetas.map(receta => (
						<a href={`/recetas/${receta.id}/`} class:list={['card', 'card-receta', { 'card--hoy': esDeHoy(receta.data.pubDate) }]}>
							<span class="etiqueta-receta">{receta.data.etiqueta}</span>
							<h3>{receta.data.title}</h3>
							<p>{receta.data.description}</p>
						</a>
					))}
				</div>
				<a href="/recetas" class="btn btn-recetas">Ver recetas</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 1.5rem 0 2rem;
		border-bottom: 1px solid #D8D6CE;
		margin-bottom: 2.5rem;
	}
	.hero h1 {
		font-size: 2.4rem;
		line-height: 1.25;
		margin-bottom: 1rem;
		max-width: 700px;
	}
	.subtitle {
		font-size: 1.05rem;
		color: #5F5E5A;
		max-width: 520px;
		margin-bottom: 0;
		line-height: 1.7;
	}
	.btn {
		display: inline-block;
		background: #6B8F71;
		color: #fff;
		padding: 0.65rem 1.5rem;
		border-radius: 6px;
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
		transition: background 0.15s;
	}
	.btn:hover {
		background: #4a6b50;
		color: #fff;
	}
	.section-title {
		font-family: 'Inter', sans-serif;
		font-size: 1.4rem;
		font-weight: 600;
		color: #6B8F71;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin: 0 0 1.5rem;
		padding-left: 0.75rem;
		border-left: 3px solid #6B8F71;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.section-title-contra {
		color: #C17A5A;
		border-left-color: #C17A5A;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin-bottom: 1.75rem;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid #B8D4BC;
		border-radius: 10px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.card:hover {
		border-color: #6B8F71;
		box-shadow: 0 2px 12px rgba(107, 143, 113, 0.12);
	}
	.card time {
		font-size: 0.75rem;
		color: #888780;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.card h3 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.05rem;
		line-height: 1.35;
		margin: 0;
		color: #2C2C2A;
	}
	.card p {
		font-size: 0.875rem;
		color: #5F5E5A;
		line-height: 1.6;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.recent-tools {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #D8D6CE;
	}
	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.etiqueta {
		font-size: 0.75rem;
		color: #888780;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.badge {
		font-size: 0.7rem;
		font-weight: 500;
		padding: 2px 8px;
		border-radius: 20px;
	}
	.badge.gratis {
		background: #E8F4EA;
		color: #4a6b50;
	}
	.badge.pago {
		background: #F4EDE8;
		color: #8B5E3C;
	}
	.recent-contra {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #D8D6CE;
	}
	.cards-contra .card {
		border-color: #E8D4C8;
	}
	.card-contra:hover {
		border-color: #C17A5A !important;
		box-shadow: 0 2px 12px rgba(193, 122, 90, 0.1) !important;
	}
	.fuente-tag {
		font-size: 0.72rem;
		color: #C17A5A;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.btn-contra {
		background: #C17A5A;
	}
	.btn-contra:hover {
		background: #9e5c3a !important;
	}
	.recent-recetas {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #D8D6CE;
	}
	.section-title-recetas {
		color: #B8860B;
		border-left-color: #B8860B;
	}
	.cards-recetas .card {
		border-color: #E8D9A0;
	}
	.card-receta:hover {
		border-color: #B8860B !important;
		box-shadow: 0 2px 12px rgba(184, 134, 11, 0.1) !important;
	}
	.etiqueta-receta {
		font-size: 0.72rem;
		color: #fff;
		background: #B8860B;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 500;
		padding: 2px 8px;
		border-radius: 20px;
		align-self: flex-start;
	}
	.btn-recetas {
		background: #B8860B;
	}
	.btn-recetas:hover {
		background: #8B6508 !important;
	}
	.card--hoy {
		background: #F0F7F1;
		border-color: #6B8F71;
	}
	.badge-hoy {
		display: inline-block;
		font-size: 0.6rem;
		font-weight: 500;
		text-transform: none;
		letter-spacing: 0.03em;
		color: #fff;
		background: #6B8F71;
		padding: 1px 7px;
		border-radius: 20px;
		align-self: flex-start;
	}
	@media (max-width: 720px) {
		.hero h1 { font-size: 2rem; }
		.cards { grid-template-columns: 1fr; }
	}
</style>
