---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;

const schemaBlogPost = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	author: {
		'@type': 'Person',
		name: 'Juan Carlos León',
		url: 'https://juancarlosleon.es',
	},
	publisher: {
		'@type': 'Person',
		name: 'Juan Carlos León',
		url: 'https://juancarlosleon.es',
	},
	inLanguage: 'es',
	url: Astro.url,
};
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} type="article" />
		<script type="application/ld+json" set:html={JSON.stringify(schemaBlogPost)} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<span class="label">Blog</span>
					<h1>{title}</h1>
					{description && <p class="description">{description}</p>}
					<div class="meta">
						<time>{pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
						{updatedDate && <span class="sep">·</span>}
						{updatedDate && <span class="updated">Actualizado el {updatedDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
					</div>
					<hr />
					<ShareButtons url={Astro.url.href} title={title} />
					<hr />
				</header>
				<div class="prose">
					<slot />
				</div>
				<footer class="post-footer">
					<a href="/blog">← Volver al blog</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		padding: 2.5rem 0 0;
		margin-bottom: 0;
	}
	.label {
		font-size: 0.75rem;
		color: #6B8F71;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 500;
		display: block;
		margin-bottom: 0.75rem;
	}
	.post-header h1 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 2.25rem;
		line-height: 1.2;
		margin: 0 0 0.75rem;
		max-width: 680px;
	}
	.description {
		font-size: 1.05rem;
		color: #5F5E5A;
		margin: 0 0 1.25rem;
		max-width: 600px;
		line-height: 1.6;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		font-size: 0.85rem;
		color: #888780;
	}
	.meta time {
		font-size: 0.8rem;
		color: #888780;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.sep { color: #D8D6CE; }
	.updated {
		font-size: 0.85rem;
		color: #888780;
		font-style: italic;
	}
	hr {
		border: none;
		border-top: 1px solid #D8D6CE;
		margin: 0;
	}
	.prose {
		margin-top: 2rem;
		max-width: 660px;
		font-size: 1.05rem;
		line-height: 1.8;
		color: #2C2C2A;
	}
	.prose p {
		margin-bottom: 1.5rem;
	}
	.prose strong {
		font-weight: 500;
		color: #1a1a18;
	}
	.prose em {
		font-style: italic;
		color: #5F5E5A;
	}
	.prose blockquote {
		border-left: 3px solid #6B8F71;
		padding: 0.25rem 0 0.25rem 1.25rem;
		margin: 1.5rem 0;
		color: #5F5E5A;
		font-style: italic;
	}
	.post-footer {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #D8D6CE;
	}
	.post-footer a {
		font-size: 0.9rem;
		color: #6B8F71;
		font-weight: 500;
		text-decoration: none;
	}
	.post-footer a:hover {
		color: #4a6b50;
	}
	@media (max-width: 720px) {
		.post-header h1 { font-size: 1.75rem; }
	}
</style>
