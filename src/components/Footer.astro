---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="copy">&copy; {today.getFullYear()} Juan Carlos León</p>
		<p class="made-with">Hecho con criterio propio, sentido común y algo de ayuda artificial</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid #D8D6CE;
		padding: 2rem 1.5rem;
		margin-top: 4rem;
	}
	.footer-inner {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}
	p {
		margin: 0;
		font-size: 0.875rem;
		color: #888780;
	}
	@media (max-width: 480px) {
		.footer-inner {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
