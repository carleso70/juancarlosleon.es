---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo">
			La FarmacIA
			<span class="logo-sub">de Juan Carlos León</span>
		</a>
		<div class="nav-links">
			<HeaderLink href="/blog">Noticias</HeaderLink>
			<HeaderLink href="/herramientas">Botiquín</HeaderLink>
			<HeaderLink href="/contraindicaciones">Contraindicaciones</HeaderLink>
			<HeaderLink href="/sobre-mi">Sobre mí</HeaderLink>
			<HeaderLink href="/contacto">Contacto</HeaderLink>

		</div>
	</nav>
</header>

<style>
	header {
		background: #6B8F71;
		border-bottom: none;
		padding: 0 1.5rem;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	nav {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 76px;
	}
	.logo {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.7rem;
		font-weight: 700;
		color: #fff;
		text-decoration: none;
		letter-spacing: -0.01em;
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}
	.logo:hover {
		color: #E8E4DC;
	}
	.logo-sub {
		font-family: 'Inter', sans-serif;
		font-size: 0.68rem;
		font-weight: 400;
		color: #E8E4DC;
		letter-spacing: 0.03em;
	}
	@media (max-width: 480px) {
		.logo { font-size: 1.35rem; }
	}
	.nav-links {
		display: flex;
		gap: 2rem;
		align-items: center;
	}
	@media (max-width: 480px) {
		.nav-links {
			gap: 1rem;
		}
	}
</style>
