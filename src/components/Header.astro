---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo">Juan Carlos León</a>
		<div class="nav-links">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/sobre-mi">Sobre mí</HeaderLink>
			<HeaderLink href="/contacto">Contacto</HeaderLink>

		</div>
	</nav>
</header>

<style>
	header {
		background: #F9F9F7;
		border-bottom: 1px solid #D8D6CE;
		padding: 0 1.5rem;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	nav {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}
	.logo {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.2rem;
		font-weight: 700;
		color: #2C2C2A;
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	.logo:hover {
		color: #6B8F71;
	}
	.nav-links {
		display: flex;
		gap: 2rem;
		align-items: center;
	}
	@media (max-width: 480px) {
		.nav-links {
			gap: 1rem;
		}
	}
</style>
